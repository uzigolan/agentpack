# --- AgentPack build output -------------------------------------------------
# Generated by `agentpack build` / `agentpack package`, including inside
# examples/. Never commit generated client packages.
dist/
packages/
agentpack-build.json
# Package workspaces and all generated artifacts live here. Their source
# manifests are local packaging inputs, not repository content.
artifacts/
bridge/*.exe

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Environments -----------------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version
uv.lock
pip-log.txt
pip-delete-this-directory.txt

# --- Testing / linting ------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/

# --- Secrets ----------------------------------------------------------------
# AgentPack never reads these, but keep them out of a capability repo by habit.
.env
.env.*
!.env.example
*.pem
*.key
!**/tests/**/*.key

# --- Editors / OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
